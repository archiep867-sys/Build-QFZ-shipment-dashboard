ADMIN_USERNAME=admin
# Optional: set a bcrypt hash to use a password you choose. If omitted, the app
# generates a random first-start password and writes it to the server startup log once.
ADMIN_PASSWORD_HASH=
# Optional: if omitted, a random secret is generated once and stored in the database.
SESSION_SECRET=
# Railway: mount a persistent volume at /data and use this exact location.
DATABASE_PATH=/data/shipments.db
# Optional; defaults to the included source workbook and seeds only an empty database.
SEED_WORKBOOK_PATH=source/Tracker for Aug 2026 - QFZ outbound shipments.xlsx
PORT=3001
