ADMIN_USERNAME=admin
# Local development only. Use a unique long password; never commit your real .env file.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Production only: set a bcrypt hash instead of a plaintext password.
ADMIN_PASSWORD_HASH=
# Required in production: at least 32 random characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Railway: mount a persistent volume at /data and use this exact location.
DATABASE_PATH=/data/shipments.db
# Optional; defaults to the included source workbook and seeds only an empty database.
SEED_WORKBOOK_PATH=source/Tracker for Aug 2026 - QFZ outbound shipments.xlsx
PORT=3001
